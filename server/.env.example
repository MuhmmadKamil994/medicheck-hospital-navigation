# MediCheck backend — copy to .env and fill in real values.
# NEVER commit a real .env (see .gitignore).
PORT=5000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<dbname>?retryWrites=true&w=majority
GEMINI_API_KEY=<your-gemini-api-key>
# Optional: override the Gemini model (default gemini-3.5-flash-lite).
# SDD 4.1 names gemini-pro, but Google retired it (v1beta 404s) — see PHASE2_NOTES.md.
#GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: Gemini request timeout in ms (SDD 4.1 default: 5000).
#GEMINI_TIMEOUT_MS=5000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64-char-hex-string>
# SMS provider: 'demo' (default — logs, no real SMS) or 'twilio' (stub:
# throws, trial unavailable in Pakistan). Future: 'eocean' local gateway.
SMS_PROVIDER=demo
# Appointment reminder cron job (every 30 min). Set false to disable.
ENABLE_REMINDERS=true
# Auto-seed 8 demo hospitals on first boot when the collection is empty.
# Idempotent; set false once you manage hospitals yourself via the admin panel.
SEED_ON_BOOT=true
# Production frontend origin(s), comma-separated — required on Render so the
# deployed frontend can call the API (e.g. CORS_ORIGIN=https://medicheck.vercel.app).
# Leave unset for local dev (open CORS).
#CORS_ORIGIN=
